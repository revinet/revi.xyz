{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@revi/revi.xyz",
  "homepage": "https://revi.xyz",
  "bugs": {
    "url": "https://revi.xyz/new"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "revi",
    "email": "revi@omglol.email"
  },
  "workspaces": [
    "./docusaurus"
  ],
  "scripts": {
    "alint": "arc lint",
    "browserlist:dev": "cd docusaurus && browserslist --env=\"development\"",
    "browserlist:prod": "cd docusaurus && browserslist --env=\"production\"",
    "build": "sh scripts/build.sh",
    "cleanbuild": "sh scripts/cleanbuild.sh",
    "dbuild": "cd docusaurus && docusaurus clear && docusaurus build",
    "dserve": "wrangler pages dev docusaurus/build/ --port 3000",
    "dstart": "cd docusaurus && docusaurus clear && docusaurus start",
    "lighthouse": "lhci autorun",
    "lint": "sh scripts/lint.sh",
    "lint:eslint": "cd docusaurus && eslint .",
    "lint:html-validate": "html-validate \"docusaurus/build/**/*.html\"",
    "lint:renovate": "renovate-config-validator",
    "lint:stylelint": "stylelint \"docusaurus/src/**/*.css\"",
    "lint:test": "arc lint && prettier --check .",
    "new": "cd docusaurus && docusaurus-post-generator new blog",
    "p:c": "prettier --check",
    "p:w": "prettier --write",
    "pw:i": "playwright install --with-deps",
    "test": "playwright test",
    "webping:send": "webmention https://revi.xyz/blog/rss.xml --limit 1 --send",
    "webping:test": "webmention https://revi.xyz/blog/rss.xml --limit 1"
  },
  "prettier": "@revi/prettier-config",
  "dependencies": {
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/nanum-gothic-coding": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "@ibm/plex": "6.4.1"
  },
  "devDependencies": {
    "@eslint/compat": "2.1.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@revi/eslint-config": "0.0.29",
    "@revi/prettier-config": "0.2.8",
    "@types/node": "24.13.3",
    "buildkite-test-collector": "1.9.5",
    "csslint": "1.0.5",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.9.0",
    "html-validate": "10.15.0",
    "jshint": "2.13.6",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "turbo": "2.10.11",
    "typescript": "5.9.3",
    "wrangler": "4.125.0"
  },
  "optionalDependencies": {
    "renovate": "44.36.0"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=20.0"
  },
  "allowScripts": {
    "@github/keytar@7.10.6": true,
    "@ibm/plex@6.4.1": true,
    "@swc/core@1.16.1": true,
    "better-sqlite3@12.4.1": true,
    "core-js@3.40.0": true,
    "core-js-pure@3.37.1": true,
    "dtrace-provider@0.8.8": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.5.4": true,
    "re2@1.26.1": true,
    "workerd@1.20260820.1": true
  }
}
